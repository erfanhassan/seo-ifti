# ==============================================================================
# Antigravity Growth OS - Live Environment Configuration (.env)
# ==============================================================================

# 1. GitHub API Authentication (For GitHub Developer Advocate Suite)
GITHUB_TOKEN=your_github_personal_access_token_here

# 2. DeepSeek AI Reasoning (For 6-Platform Copywriting, Sniper Copilot, Reddit Karma Builder)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 3. Server Configuration
PORT=8080
LOG_LEVEL=INFO
ENVIRONMENT=production
ADMIN_API_KEY=admin_sec_growth_suite_2026
WEBHOOK_SECRET=whsec_growth_suite_2026

# 4. Database & Media Storage
DATABASE_URL=sqlite:///./socials_os.db
MEDIA_STORAGE_DIR=./media_storage

# 5. Video Transcoding & Quality Control Thresholds
MAX_VIDEO_MASTER_SIZE_MB=2000.0        # Videos >= 2GB routed directly to YouTube & Facebook (Lossless)
COMPRESSED_VIDEO_MAX_SIZE_MB=300.0    # Transcoded 1080p H.264 (<300MB) for Instagram, TikTok, Twitter/X

# 6. Unified Social Publishing API (Ayrshare / Upload-Post / Zernio)
UNIFIED_SOCIAL_PROVIDER=ayrshare
UNIFIED_SOCIAL_API_KEY=
UNIFIED_SOCIAL_ENDPOINT=https://app.ayrshare.com/api/post

# 7. Facebook / Meta Graph API
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_USER_ACCESS_TOKEN=

# 8. Twitter / X API v2
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_BEARER_TOKEN=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# 9. Reddit API (PRAW) - Optional credentials for live native posting
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=SocialsOS:v1.0.0 (by /u/FounderAdvocate)
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_SUBREDDITS=HealthTech,SaaS,MachineLearning,medicine

